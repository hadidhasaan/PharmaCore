PHARMACORE_APP_ENV=local
PHARMACORE_DB_HOST=127.0.0.1
PHARMACORE_DB_PORT=3306
PHARMACORE_DB_NAME=pharmacore
PHARMACORE_DB_USER=root
PHARMACORE_DB_PASS=
PHARMACORE_WEB_MIGRATIONS=0
PHARMACORE_MIGRATION_TOKEN=

# Backup & Recovery (optional; XAMPP auto-detects C:\xampp\mysql\bin on Windows)
PHARMACORE_BACKUP_PATH=
PHARMACORE_MYSQLDUMP_BIN=
PHARMACORE_MYSQL_BIN=
# Keep web restore disabled unless this is a trusted administrative environment.
PHARMACORE_WEB_RESTORE=0
PHARMACORE_BACKUP_TIMEOUT=300
PHARMACORE_RESTORE_TIMEOUT=900
PHARMACORE_MAX_RESTORE_BYTES=268435456
PHARMACORE_MAX_BACKUP_FILES=5000

# Optional system ZIP executable used when PHP ZipArchive is unavailable
# PHARMACORE_ZIP_BIN=C:\path\to\zip.exe
